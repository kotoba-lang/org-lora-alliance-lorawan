;; One workspace-local git dependency: org-nist-aes, for the AES-128 block
;; cipher. LoRaWAN's MIC (AES-CMAC, RFC 4493) and its FRMPayload scheme
;; (an AES-CTR-shaped construction built from repeated single-block
;; encryption, LoRaWAN L2 1.0.4 §4.3.3) are both built *on top of* that one
;; primitive here — this repo does not implement or vendor a second AES.
;; Pinned to a commit reachable from org-nist-aes's own default branch
;; (`main`); verified 2026-08-30 with
;; `gh api repos/kotoba-lang/org-nist-aes/commits/main --jq .sha`.
{:paths ["src"]
 :deps {org.kotoba-lang/org-nist-aes
        {:git/url "https://github.com/kotoba-lang/org-nist-aes"
         :git/sha "7834b2f04729ab77259da26a8d728fe3595f041e"
         :deps/root "."}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  ;; The oracle needs no dependency: javax.crypto ships with the JVM. Same
  ;; pattern as org-nist-aes's own :oracle alias — a separate alias so the
  ;; ClojureScript path never tries to load it.
  :oracle {:extra-paths ["test" "oracle"]
           :extra-deps {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
           :main-opts ["-m" "cognitect.test-runner" "-d" "test" "-d" "oracle"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
